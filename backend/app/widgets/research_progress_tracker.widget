{
  "version": "1.0",
  "name": "research_progress_tracker",
  "template": "{% set title_icon = \"data:image/webp;base64,\" %}{\n  \"type\": \"Card\",\n  \"size\": \"lg\",\n  \"padding\": 4,\n  \"background\": \"#F4F3EC\",\n  \"status\": {\n    \"text\": {{ status_text | tojson }},\n    \"icon\": {{ status_icon | tojson }}\n  },\n  \"children\": [\n    {\n      \"type\": \"Row\",\n      \"justify\": \"between\",\n      \"align\": \"center\",\n      \"gap\": 2,\n      \"wrap\": \"wrap\",\n      \"children\": [\n        {\n          \"type\": \"Row\",\n          \"align\": \"center\",\n          \"gap\": 2,\n          \"flex\": 1,\n          \"children\": [\n            { \"type\": \"Image\", \"src\": {{ title_icon | tojson }}, \"alt\": \"\", \"width\": 24, \"height\": 24, \"fit\": \"contain\" },\n            {\n              \"type\": \"Title\",\n              \"value\": \"Temporal Research Pipeline\",\n              \"size\": \"sm\",\n              \"weight\": \"semibold\",\n              \"color\": \"#131420\"\n            }\n          ]\n        },\n        {\n          \"type\": \"Badge\",\n          \"label\": {{ phase_label | tojson }},\n          \"color\": {{ phase_color | tojson }},\n          \"variant\": \"soft\",\n          \"size\": \"sm\",\n          \"pill\": true\n        }\n      ]\n    },\n    {\n      \"type\": \"Box\",\n      \"background\": \"#FFFFFF\",\n      \"padding\": { \"x\": 3, \"y\": 2 },\n      \"radius\": \"xl\",\n      \"border\": {\n        \"left\": { \"size\": 3, \"color\": \"#583AD8\" },\n        \"top\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n        \"right\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n        \"bottom\": { \"size\": 1, \"color\": \"#E3E0D5\" }\n      },\n      \"children\": [\n        {\n          \"type\": \"Text\",\n          \"value\": {{ message | tojson }},\n          \"color\": \"#131420\",\n          \"size\": \"sm\"\n        }\n      ]\n    }\n    {% if enhanced_prompt %},\n    {\n      \"type\": \"Col\",\n      \"gap\": 1,\n      \"background\": \"#FAF9F5\",\n      \"padding\": { \"x\": 3, \"y\": 2 },\n      \"radius\": \"xl\",\n      \"border\": {\n        \"left\": { \"size\": 3, \"color\": \"#583AD8\" },\n        \"top\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n        \"right\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n        \"bottom\": { \"size\": 1, \"color\": \"#E3E0D5\" }\n      },\n      \"children\": [\n        {\n          \"type\": \"Row\",\n          \"align\": \"center\",\n          \"justify\": \"between\",\n          \"gap\": 2,\n          \"children\": [\n            {\n              \"type\": \"Row\",\n              \"align\": \"center\",\n              \"gap\": 1,\n              \"children\": [\n                { \"type\": \"Icon\", \"name\": \"sparkle\", \"size\": \"sm\", \"color\": \"#583AD8\" },\n                {\n                  \"type\": \"Caption\",\n                  \"value\": \"ENHANCED RESEARCH BRIEF\",\n                  \"color\": \"#583AD8\",\n                  \"weight\": \"semibold\",\n                  \"size\": \"md\"\n                }\n              ]\n            },\n            {\n              \"type\": \"Badge\",\n              \"label\": \"Prompt Enhanced\",\n              \"color\": \"info\",\n              \"variant\": \"soft\",\n              \"size\": \"sm\",\n              \"pill\": true\n            }\n          ]\n        },\n        {\n          \"type\": \"Text\",\n          \"value\": {{ enhanced_prompt | tojson }},\n          \"color\": \"#4B4C5E\",\n          \"size\": \"xs\",\n          \"maxLines\": 4\n        }\n      ]\n    }\n    {% endif %},\n    { \"type\": \"Divider\", \"color\": \"#E3E0D5\", \"flush\": true },\n    {\n      \"type\": \"Col\",\n      \"gap\": 2,\n      \"background\": \"#FFFFFF\",\n      \"padding\": 3,\n      \"radius\": \"xl\",\n      \"border\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n      \"children\": [\n        {% for step in steps %}\n        {\n          \"type\": \"Row\",\n          \"justify\": \"between\",\n          \"align\": \"center\",\n          \"gap\": 2,\n          \"padding\": { \"x\": 2, \"y\": 2 },\n          \"radius\": \"xl\",\n          \"background\": {{ (\"#E6FAF2\" if step.status == \"Done\" else (\"#F1EEFF\" if step.status == \"Active\" else \"#FAF9F5\")) | tojson }},\n          \"children\": [\n            {\n              \"type\": \"Row\",\n              \"gap\": 2,\n              \"align\": \"center\",\n              \"children\": [\n                {\n                  \"type\": \"Icon\",\n                  \"name\": {{ step.icon | tojson }},\n                  \"size\": \"sm\",\n                  \"color\": {{ (\"#131420\" if step.status == \"Done\" else (\"#583AD8\" if step.status == \"Active\" else \"#68697B\")) | tojson }}\n                },\n                {\n                  \"type\": \"Text\",\n                  \"value\": {{ step.label | tojson }},\n                  \"size\": \"sm\",\n                  \"weight\": {{ (\"semibold\" if step.status == \"Active\" else \"medium\") | tojson }},\n                  \"color\": {{ (\"#131420\" if step.status != \"Pending\" else \"#4B4C5E\") | tojson }}\n                }\n              ]\n            },\n            {\n              \"type\": \"Badge\",\n              \"label\": {{ step.status | tojson }},\n              \"color\": {{ step.color | tojson }},\n              \"variant\": \"soft\",\n              \"size\": \"sm\",\n              \"pill\": true\n            }\n          ]\n        }{% if not loop.last %},{% endif %}\n        {% endfor %}\n      ]\n    }\n    {% if total_sub_questions > 0 %},\n    { \"type\": \"Divider\", \"color\": \"#E3E0D5\", \"flush\": true },\n    {\n      \"type\": \"Row\",\n      \"justify\": \"between\",\n      \"align\": \"center\",\n      \"gap\": 2,\n      \"background\": \"#FAF9F5\",\n      \"padding\": { \"x\": 3, \"y\": 2 },\n      \"radius\": \"xl\",\n      \"border\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n      \"children\": [\n        {\n          \"type\": \"Caption\",\n          \"value\": \"Web searches completed\",\n          \"color\": \"#4B4C5E\",\n          \"size\": \"md\"\n        },\n        {\n          \"type\": \"Text\",\n          \"value\": {{ (completed_sub_questions ~ \"/\" ~ total_sub_questions) | tojson }},\n          \"size\": \"sm\",\n          \"weight\": \"semibold\",\n          \"color\": \"#583AD8\"\n        }\n      ]\n    }\n    {% endif %}\n  ]\n}",
  "jsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "status_text",
      "status_icon",
      "phase_label",
      "phase_color",
      "message",
      "enhanced_prompt",
      "steps",
      "completed_sub_questions",
      "total_sub_questions"
    ],
    "properties": {
      "status_text": { "type": "string" },
      "status_icon": { "type": "string" },
      "phase_label": { "type": "string" },
      "phase_color": { "type": "string" },
      "message": { "type": "string" },
      "enhanced_prompt": { "type": "string" },
      "completed_sub_questions": { "type": "integer", "minimum": 0 },
      "total_sub_questions": { "type": "integer", "minimum": 0 },
      "steps": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["label", "icon", "status", "color"],
          "properties": {
            "label": { "type": "string" },
            "icon": { "type": "string" },
            "status": { "type": "string" },
            "color": { "type": "string" }
          }
        }
      }
    }
  }
}
