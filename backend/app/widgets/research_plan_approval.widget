{
  "version": "1.0",
  "name": "research_plan_approval",
  "template": "{% set title_icon = \"data:image/webp;base64,\" %}{% if state == \"pending\" %}{\n  \"type\": \"Card\",\n  \"size\": \"lg\",\n  \"padding\": 4,\n  \"background\": \"#F4F3EC\",\n  \"asForm\": true,\n  \"status\": {\n    \"text\": \"Human-in-the-Loop • Approval Required\",\n    \"icon\": \"compass\"\n  },\n  \"children\": [\n    {\n      \"type\": \"Row\",\n      \"justify\": \"between\",\n      \"align\": \"center\",\n      \"gap\": 2,\n      \"wrap\": \"wrap\",\n      \"children\": [\n        {\n          \"type\": \"Row\",\n          \"align\": \"center\",\n          \"gap\": 2,\n          \"flex\": 1,\n          \"children\": [\n            { \"type\": \"Image\", \"src\": {{ title_icon | tojson }}, \"alt\": \"\", \"width\": 24, \"height\": 24, \"fit\": \"contain\" },\n            {\n              \"type\": \"Title\",\n              \"value\": \"Review Research Plan\",\n              \"size\": \"md\",\n              \"weight\": \"semibold\",\n              \"color\": \"#131420\"\n            }\n          ]\n        },\n        {\n          \"type\": \"Badge\",\n          \"label\": \"Awaiting Approval\",\n          \"color\": \"warning\",\n          \"variant\": \"soft\",\n          \"size\": \"sm\",\n          \"pill\": true\n        }\n      ]\n    },\n    {\n      \"type\": \"Col\",\n      \"gap\": 2,\n      \"background\": \"#FFFFFF\",\n      \"padding\": 3,\n      \"radius\": \"xl\",\n      \"border\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n      \"children\": [\n        {\n          \"type\": \"Text\",\n          \"value\": \"Select the sub-questions to investigate in parallel:\",\n          \"size\": \"sm\",\n          \"weight\": \"medium\",\n          \"color\": \"#131420\"\n        },\n        {\n          \"type\": \"Col\",\n          \"gap\": 2,\n          \"children\": [\n            {% for question in sub_questions %}\n            {\n              \"type\": \"Checkbox\",\n              \"name\": {{ (\"q_\" ~ loop.index0) | tojson }},\n              \"label\": {{ question | tojson }},\n              \"defaultChecked\": true\n            }{% if not loop.last %},{% endif %}\n            {% endfor %}\n          ]\n        }\n      ]\n    },\n    {\n      \"type\": \"Col\",\n      \"gap\": 3,\n      \"background\": \"#FAF9F5\",\n      \"padding\": 3,\n      \"radius\": \"xl\",\n      \"border\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n      \"children\": [\n        {\n          \"type\": \"Row\",\n          \"gap\": 3,\n          \"align\": \"center\",\n          \"justify\": \"between\",\n          \"wrap\": \"wrap\",\n          \"children\": [\n            {\n              \"type\": \"Label\",\n              \"value\": \"Depth\",\n              \"fieldName\": \"depth\",\n              \"size\": \"sm\",\n              \"weight\": \"semibold\",\n              \"color\": \"#131420\"\n            },\n            {\n              \"type\": \"Select\",\n              \"name\": \"depth\",\n              \"defaultValue\": {{ selected_depth | tojson }},\n              \"size\": \"sm\",\n              \"pill\": true,\n              \"variant\": \"outline\",\n              \"options\": [\n                { \"value\": \"concise\", \"label\": \"Concise\", \"description\": \"Fast high-level synthesis\" },\n                { \"value\": \"standard\", \"label\": \"Standard\", \"description\": \"Balanced evidence and breadth\" },\n                { \"value\": \"deep\", \"label\": \"Deep Dive\", \"description\": \"Thorough multi-angle analysis\" }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"Col\",\n          \"gap\": 1,\n          \"children\": [\n            {\n              \"type\": \"Label\",\n              \"value\": \"Additional focus\",\n              \"fieldName\": \"extra_focus\",\n              \"size\": \"sm\",\n              \"weight\": \"medium\",\n              \"color\": \"#4B4C5E\"\n            },\n            {\n              \"type\": \"Input\",\n              \"name\": \"extra_focus\",\n              \"placeholder\": \"Optional: add a custom angle or sub-question...\",\n              \"size\": \"lg\",\n              \"pill\": true,\n              \"variant\": \"outline\"\n            }\n          ]\n        }\n      ]\n    }\n  ],\n  \"confirm\": {\n    \"label\": \"Approve & Run Research\",\n    \"action\": {\n      \"type\": {{ approve_action_type | tojson }},\n      \"payload\": {\n        \"workflow_id\": {{ workflow_id | tojson }},\n        \"sub_questions\": {{ sub_questions | tojson }}\n      }\n    }\n  },\n  \"cancel\": {\n    \"label\": \"Cancel Run\",\n    \"action\": {\n      \"type\": {{ reject_action_type | tojson }},\n      \"payload\": {\n        \"workflow_id\": {{ workflow_id | tojson }}\n      }\n    }\n  }\n}{% else %}{\n  \"type\": \"Card\",\n  \"size\": \"lg\",\n  \"padding\": 4,\n  \"background\": \"#F4F3EC\",\n  \"status\": {\n    \"text\": {{ status_text | tojson }},\n    \"icon\": {{ status_icon | tojson }}\n  },\n  \"children\": [\n    {\n      \"type\": \"Row\",\n      \"justify\": \"between\",\n      \"align\": \"center\",\n      \"gap\": 2,\n      \"wrap\": \"wrap\",\n      \"children\": [\n        {\n          \"type\": \"Row\",\n          \"align\": \"center\",\n          \"gap\": 2,\n          \"flex\": 1,\n          \"children\": [\n            { \"type\": \"Image\", \"src\": {{ title_icon | tojson }}, \"alt\": \"\", \"width\": 24, \"height\": 24, \"fit\": \"contain\" },\n            {\n              \"type\": \"Title\",\n              \"value\": \"Research Plan\",\n              \"size\": \"md\",\n              \"weight\": \"semibold\",\n              \"color\": \"#131420\"\n            }\n          ]\n        },\n        {\n          \"type\": \"Badge\",\n          \"label\": {{ badge_label | tojson }},\n          \"color\": {{ badge_color | tojson }},\n          \"variant\": \"soft\",\n          \"size\": \"sm\",\n          \"pill\": true\n        }\n      ]\n    }\n    {% if state == \"approved\" and sub_questions %},\n    { \"type\": \"Divider\", \"color\": \"#E3E0D5\", \"flush\": true },\n    {\n      \"type\": \"Col\",\n      \"gap\": 2,\n      \"background\": \"#FFFFFF\",\n      \"padding\": 3,\n      \"radius\": \"xl\",\n      \"border\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n      \"children\": [\n        {% for question in sub_questions %}\n        {\n          \"type\": \"Row\",\n          \"gap\": 2,\n          \"align\": \"center\",\n          \"children\": [\n            {\n              \"type\": \"Box\",\n              \"background\": \"#E6FAF2\",\n              \"padding\": 1,\n              \"radius\": \"full\",\n              \"children\": [\n                { \"type\": \"Icon\", \"name\": \"check\", \"size\": \"xs\", \"color\": \"#131420\" }\n              ]\n            },\n            {\n              \"type\": \"Text\",\n              \"value\": {{ question | tojson }},\n              \"size\": \"sm\",\n              \"color\": \"#131420\"\n            }\n          ]\n        }{% if not loop.last %},{% endif %}\n        {% endfor %}\n      ]\n    }\n    {% if extra_focus %},\n    {\n      \"type\": \"Box\",\n      \"background\": \"#FAF9F5\",\n      \"padding\": { \"x\": 3, \"y\": 2 },\n      \"radius\": \"xl\",\n      \"border\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n      \"children\": [\n        {\n          \"type\": \"Text\",\n          \"value\": {{ (\"Added focus: \" ~ extra_focus) | tojson }},\n          \"color\": \"#4B4C5E\",\n          \"size\": \"sm\"\n        }\n      ]\n    }\n    {% endif %}\n    {% endif %}\n  ]\n}{% endif %}",
  "jsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "workflow_id",
      "sub_questions",
      "state",
      "selected_depth",
      "extra_focus",
      "approve_action_type",
      "reject_action_type",
      "badge_label",
      "badge_color",
      "status_icon",
      "status_text"
    ],
    "properties": {
      "workflow_id": { "type": "string" },
      "sub_questions": { "type": "array", "items": { "type": "string" } },
      "state": { "type": "string", "enum": ["pending", "approved", "cancelled"] },
      "selected_depth": { "type": "string", "enum": ["concise", "standard", "deep"] },
      "extra_focus": { "type": "string" },
      "approve_action_type": { "type": "string" },
      "reject_action_type": { "type": "string" },
      "badge_label": { "type": "string" },
      "badge_color": { "type": "string" },
      "status_icon": { "type": "string" },
      "status_text": { "type": "string" }
    }
  }
}
