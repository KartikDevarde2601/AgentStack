{
  "version": "1.0",
  "name": "research_followup_actions",
  "template": "{% set title_icon = \"data:image/webp;base64,\" %}{\n  \"type\": \"Card\",\n  \"size\": \"lg\",\n  \"padding\": 4,\n  \"background\": \"#F4F3EC\",\n  \"status\": {\n    \"text\": \"Next Steps\",\n    \"icon\": \"sparkle\"\n  },\n  \"children\": [\n    {\n      \"type\": \"Row\",\n      \"align\": \"center\",\n      \"gap\": 2,\n      \"flex\": 1,\n      \"children\": [\n        { \"type\": \"Image\", \"src\": {{ title_icon | tojson }}, \"alt\": \"\", \"width\": 24, \"height\": 24, \"fit\": \"contain\" },\n        {\n          \"type\": \"Title\",\n          \"value\": \"Continue exploring this research report\",\n          \"size\": \"sm\",\n          \"weight\": \"semibold\",\n          \"color\": \"#131420\"\n        }\n      ]\n    },\n    {\n      \"type\": \"Box\",\n      \"background\": \"#FFFFFF\",\n      \"padding\": { \"x\": 3, \"y\": 2 },\n      \"radius\": \"xl\",\n      \"border\": {\n        \"left\": { \"size\": 3, \"color\": \"#583AD8\" },\n        \"top\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n        \"right\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n        \"bottom\": { \"size\": 1, \"color\": \"#E3E0D5\" }\n      },\n      \"children\": [\n        {\n          \"type\": \"Text\",\n          \"value\": {{ query | tojson }},\n          \"color\": \"#4B4C5E\",\n          \"size\": \"sm\",\n          \"maxLines\": 2\n        }\n      ]\n    },\n    { \"type\": \"Divider\", \"color\": \"#E3E0D5\", \"flush\": true },\n    {\n      \"type\": \"Row\",\n      \"gap\": 2,\n      \"wrap\": \"wrap\",\n      \"children\": [\n        {\n          \"type\": \"Button\",\n          \"label\": \"Executive TL;DR\",\n          \"iconStart\": \"document\",\n          \"variant\": \"soft\",\n          \"color\": \"secondary\",\n          \"size\": \"md\",\n          \"pill\": true,\n          \"onClickAction\": {\n            \"type\": {{ followup_action_type | tojson }},\n            \"payload\": {\n              \"workflow_id\": {{ workflow_id | tojson }},\n              \"query\": {{ query | tojson }},\n              \"mode\": \"tldr\"\n            }\n          }\n        },\n        {\n          \"type\": \"Button\",\n          \"label\": \"Sources Index\",\n          \"iconStart\": \"globe\",\n          \"variant\": \"outline\",\n          \"color\": \"secondary\",\n          \"size\": \"md\",\n          \"pill\": true,\n          \"onClickAction\": {\n            \"type\": {{ followup_action_type | tojson }},\n            \"payload\": {\n              \"workflow_id\": {{ workflow_id | tojson }},\n              \"query\": {{ query | tojson }},\n              \"mode\": \"sources\"\n            }\n          }\n        },\n        {\n          \"type\": \"Button\",\n          \"label\": \"Deep-Dive Follow-Up\",\n          \"iconStart\": \"sparkle\",\n          \"style\": \"primary\",\n          \"size\": \"md\",\n          \"pill\": true,\n          \"onClickAction\": {\n            \"type\": {{ followup_action_type | tojson }},\n            \"payload\": {\n              \"workflow_id\": {{ workflow_id | tojson }},\n              \"query\": {{ query | tojson }},\n              \"mode\": \"deep_dive\"\n            }\n          }\n        }\n      ]\n    }\n  ]\n}",
  "jsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["workflow_id", "query", "followup_action_type"],
    "properties": {
      "workflow_id": { "type": "string" },
      "query": { "type": "string" },
      "followup_action_type": { "type": "string" }
    }
  }
}
