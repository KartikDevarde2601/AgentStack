{
  "version": "1.0",
  "name": "research_followup_actions",
  "template": "{% set title_icon = \"data:image/webp;base64,\" %}{\n  \"type\": \"Card\",\n  \"size\": \"lg\",\n  \"padding\": 4,\n  \"background\": \"#F4F3EC\",\n  \"status\": {\n    \"text\": \"Next Steps\",\n    \"icon\": \"sparkle\"\n  },\n  \"children\": [\n    {\n      \"type\": \"Row\",\n      \"align\": \"center\",\n      \"gap\": 2,\n      \"flex\": 1,\n      \"children\": [\n        { \"type\": \"Image\", \"src\": {{ title_icon | tojson }}, \"alt\": \"\", \"width\": 24, \"height\": 24, \"fit\": \"contain\" },\n        {\n          \"type\": \"Title\",\n          \"value\": \"Continue exploring this research report\",\n          \"size\": \"sm\",\n          \"weight\": \"semibold\",\n          \"color\": \"#131420\"\n        }\n      ]\n    },\n    {\n      \"type\": \"Box\",\n      \"background\": \"#FFFFFF\",\n      \"padding\": { \"x\": 3, \"y\": 2 },\n      \"radius\": \"xl\",\n      \"border\": {\n        \"left\": { \"size\": 3, \"color\": \"#583AD8\" },\n        \"top\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n        \"right\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n        \"bottom\": { \"size\": 1, \"color\": \"#E3E0D5\" }\n      },\n      \"children\": [\n        {\n          \"type\": \"Text\",\n          \"value\": {{ query | tojson }},\n          \"color\": \"#4B4C5E\",\n          \"size\": \"sm\",\n          \"maxLines\": 2\n        }\n      ]\n    },\n    { \"type\": \"Divider\", \"color\": \"#E3E0D5\", \"flush\": true },\n    {% if follow_up_questions %}\n    {\n      \"type\": \"Col\",\n      \"gap\": 2,\n      \"children\": [\n        {\n          \"type\": \"Caption\",\n          \"value\": \"SUGGESTED FOLLOW-UP QUESTIONS\",\n          \"color\": \"#583AD8\",\n          \"weight\": \"semibold\",\n          \"size\": \"md\"\n        },\n        {% for fq in follow_up_questions %}\n        {\n          \"type\": \"Row\",\n          \"justify\": \"between\",\n          \"align\": \"center\",\n          \"gap\": 3,\n          \"padding\": { \"x\": 3, \"y\": 2 },\n          \"radius\": \"xl\",\n          \"background\": \"#FFFFFF\",\n          \"border\": { \"size\": 1, \"color\": \"#E3E0D5\" },\n          \"children\": [\n            {\n              \"type\": \"Row\",\n              \"gap\": 2,\n              \"align\": \"start\",\n              \"flex\": 1,\n              \"children\": [\n                { \"type\": \"Icon\", \"name\": \"sparkle\", \"size\": \"sm\", \"color\": \"#583AD8\" },\n                {\n                  \"type\": \"Text\",\n                  \"value\": {{ fq | tojson }},\n                  \"color\": \"#131420\",\n                  \"size\": \"sm\",\n                  \"maxLines\": 3\n                }\n              ]\n            },\n            {\n              \"type\": \"Button\",\n              \"label\": \"Explore\",\n              \"iconEnd\": \"chevron-right\",\n              \"variant\": \"soft\",\n              \"color\": \"secondary\",\n              \"size\": \"sm\",\n              \"pill\": true,\n              \"onClickAction\": {\n                \"type\": {{ followup_action_type | tojson }},\n                \"payload\": {\n                  \"workflow_id\": {{ workflow_id | tojson }},\n                  \"query\": {{ query | tojson }},\n                  \"mode\": \"custom\",\n                  \"prompt\": {{ fq | tojson }}\n                }\n              }\n            }\n          ]\n        }{% if not loop.last %},{% endif %}\n        {% endfor %}\n      ]\n    },\n    { \"type\": \"Divider\", \"color\": \"#E3E0D5\", \"flush\": true },\n    {% endif %}\n    {\n      \"type\": \"Row\",\n      \"gap\": 2,\n      \"wrap\": \"wrap\",\n      \"children\": [\n        {\n          \"type\": \"Button\",\n          \"label\": \"Executive TL;DR\",\n          \"iconStart\": \"document\",\n          \"variant\": \"soft\",\n          \"color\": \"secondary\",\n          \"size\": \"md\",\n          \"pill\": true,\n          \"onClickAction\": {\n            \"type\": {{ followup_action_type | tojson }},\n            \"payload\": {\n              \"workflow_id\": {{ workflow_id | tojson }},\n              \"query\": {{ query | tojson }},\n              \"mode\": \"executive_summary\"\n            }\n          }\n        },\n        {\n          \"type\": \"Button\",\n          \"label\": \"Compare Alternatives\",\n          \"iconStart\": \"globe\",\n          \"variant\": \"outline\",\n          \"color\": \"secondary\",\n          \"size\": \"md\",\n          \"pill\": true,\n          \"onClickAction\": {\n            \"type\": {{ followup_action_type | tojson }},\n            \"payload\": {\n              \"workflow_id\": {{ workflow_id | tojson }},\n              \"query\": {{ query | tojson }},\n              \"mode\": \"compare_alternatives\"\n            }\n          }\n        },\n        {\n          \"type\": \"Button\",\n          \"label\": \"Deep-Dive Follow-Up\",\n          \"iconStart\": \"sparkle\",\n          \"style\": \"primary\",\n          \"size\": \"md\",\n          \"pill\": true,\n          \"onClickAction\": {\n            \"type\": {{ followup_action_type | tojson }},\n            \"payload\": {\n              \"workflow_id\": {{ workflow_id | tojson }},\n              \"query\": {{ query | tojson }},\n              \"mode\": \"deep_dive\"\n            }\n          }\n        }\n      ]\n    }\n  ]\n}",
  "jsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["workflow_id", "query", "followup_action_type", "follow_up_questions"],
    "properties": {
      "workflow_id": { "type": "string" },
      "query": { "type": "string" },
      "followup_action_type": { "type": "string" },
      "follow_up_questions": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
