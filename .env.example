# OpenAI SDK (optional: if unset, the demo runs a deterministic mock deep-researcher)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Postgres
DATABASE_URL=postgresql://agentstack:agentstack@localhost:5439/agentstack

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=deep-research-queue

# FastAPI
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Vite Frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_CHATKIT_DOMAIN_KEY=domain_pk_local_demo
